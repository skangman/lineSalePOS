PORT=3100
NODE_ENV=production

# Aiven PostgreSQL connection string (ต้องเป็น PostgreSQL service ไม่ใช่ MySQL)
# คัดลอกจาก Aiven console > service > Connection information > Connection URI
# ควรมี ?sslmode=require ต่อท้าย
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_ID=
JWT_SECRET=

# โดเมน frontend ที่อนุญาตให้เรียก API (คั่นด้วย , ได้ถ้ามีหลายโดเมน)
FRONTEND_URL=https://your-app.vercel.app

ADMIN_SECRET=
ADMIN_PROMPTPAY=

# Vercel Blob — สร้างจาก Vercel dashboard > Storage > Create Database > Blob แล้วเชื่อมเข้า project
# พอเชื่อมแล้ว Vercel จะตั้งตัวแปรนี้ให้อัตโนมัติ ไม่ต้อง copy เองยกเว้นรันทดสอบ local
BLOB_READ_WRITE_TOKEN=
